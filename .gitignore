# Editor caches and generated build outputs
**/Library/
**/Temp/
**/Obj/
**/Logs/
**/UserSettings/
**/.vs/
**/Binaries/
**/Intermediate/
**/DerivedDataCache/
**/Saved/
benchmark/builds/
benchmark/local/
benchmark/art/**/*.log
benchmark/**/evidence/*.log
# Installer screenshots are local setup diagnostics, not game-art evidence.
benchmark/unreal/evidence/engine-download-active.png
benchmark/unreal/evidence/epic-*.png
benchmark/unreal/evidence/vs-*.png
*.blend1
*.blend2
*.sln
*.csproj
*.vcxproj*
__pycache__/
# Imports are reproduced from benchmark/shared, preserving source assets once.
benchmark/unity/Assets/Benchmark/Imported/
benchmark/unity/Assets/Benchmark/Imported.meta
# Deterministic Unity scene, prefabs and packed materials are rebuilt by Prepare.
benchmark/unity/Assets/Benchmark/Generated/
benchmark/unity/Assets/Benchmark/Scenes/
benchmark/unity/Assets/Resources/PerformanceTestRun*.json*
benchmark/unreal/KragKingsBenchmark/Content/Benchmark/
# Local revision archives and derived Blender export assembly; current masters
# and engine-neutral exported assets remain versioned through Git LFS.
benchmark/art/**/versions/
benchmark/art/krag/Krag_Runtime.blend
# Download archives and derived anatomy inspection arrays; extracted originals
# and provenance remain versioned.
benchmark/art/reference-anatomy/**/*.zip
benchmark/art/**/anatomy-study/*.npz
